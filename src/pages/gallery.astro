---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';

const root = path.join(process.cwd(), 'public', 'gallery');
const imageExt = /\.(jpe?g|png|webp|avif|gif)$/i;
const byName = new Intl.Collator(undefined, { numeric: true }).compare;

// Reads every image in public/gallery, including any subfolders
function collect(dir: string, urlBase: string): { src: string; alt: string }[] {
  return fs
    .readdirSync(dir, { withFileTypes: true })
    .sort((a, b) => byName(a.name, b.name))
    .flatMap((entry) => {
      const url = `${urlBase}/${encodeURIComponent(entry.name)}`;
      if (entry.isDirectory()) return collect(path.join(dir, entry.name), url);
      if (!imageExt.test(entry.name)) return [];
      return [{ src: url, alt: `ATL gallery photo: ${entry.name.replace(/\.[^.]+$/, '').replace(/[-_]+/g, ' ')}` }];
    });
}

const photos = fs.existsSync(root) ? collect(root, '/gallery') : [];
---

<BaseLayout title="Event Gallery" description="Browse photos from ATL events at DAV Public School, Unit-VIII." noindex={photos.length === 0}>
  <header class="projects-intro">
    <p class="eyebrow">In pictures</p>
    <h1>Event gallery</h1>
    <p>Browse photos from ATL events and activities. Tap a photo to see it full size.</p>
    <a class="text-link" href="/events/">All events <span aria-hidden="true">→</span></a>
  </header>

  <section class="projects-section" aria-labelledby="photos-heading">
    <div class="projects-section__heading">
      <h2 id="photos-heading">Photos</h2>
      <p>{photos.length} {photos.length === 1 ? 'photo' : 'photos'}</p>
    </div>

    {photos.length > 0 ? (
      <div class="photo-grid">
        {photos.map((photo) => (
          <a class="photo-grid__item" href={photo.src} target="_blank" rel="noopener">
            <img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" />
          </a>
        ))}
      </div>
    ) : (
      <p class="projects-empty">Photos will appear here soon.</p>
    )}
  </section>
</BaseLayout>

<style>
  .photo-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr)); gap: var(--space-4); }
  .photo-grid__item { display: block; overflow: hidden; border: 1px solid var(--line); border-radius: var(--radius-md); background: var(--surface); box-shadow: var(--shadow-soft); }
  .photo-grid__item img { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; transition: transform 0.25s ease; }
  .photo-grid__item:hover img { transform: scale(1.04); }
  .photo-grid__item:focus-visible { outline: 3px solid var(--blue); outline-offset: 3px; }
</style>