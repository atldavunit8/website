---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { isPublished } from '../lib/content';
import { formatDate } from '../lib/dates';

const albums = (await getCollection('events', isPublished))
  .filter((entry) => entry.data.gallery.length > 0)
  .sort((a, b) => (b.data.date ?? String(b.data.year ?? '')).localeCompare(a.data.date ?? String(a.data.year ?? '')));
---

<BaseLayout title="Event Gallery" description="Browse published photo albums from ATL events at DAV Public School, Unit-VIII." noindex={albums.length === 0}>
  <header class="projects-intro"><p class="eyebrow">In pictures</p><h1>Event gallery</h1><p>Browse photos by event. Open an album for captions and full-size images.</p><a class="text-link" href="/events/">All events <span aria-hidden="true">→</span></a></header>
  <section class="projects-section" aria-labelledby="albums-heading">
    <div class="projects-section__heading"><h2 id="albums-heading">Photo albums</h2><p>{albums.length} {albums.length === 1 ? 'album' : 'albums'}</p></div>
    {albums.length > 0 ? <div class="editorial-grid">{albums.map((entry) => <article class="editorial-card gallery-album"><a class="editorial-card__image" href={`/events/${entry.id}/#event-photos`} aria-label={`Open ${entry.data.title} album`}><img src={entry.data.gallery[0].src} alt={entry.data.gallery[0].alt} width={entry.data.gallery[0].width ?? 800} height={entry.data.gallery[0].height ?? 600} loading="lazy" decoding="async" /></a><div class="editorial-card__body"><span class="badge badge--category">{entry.data.gallery.length} {entry.data.gallery.length === 1 ? 'photo' : 'photos'}</span><h3><a href={`/events/${entry.id}/#event-photos`}>{entry.data.title}</a></h3>{entry.data.date && <p class="editorial-card__meta">{formatDate(entry.data.date)}</p>}<a class="text-link" href={`/events/${entry.id}/#event-photos`}>Open album <span aria-hidden="true">→</span></a></div></article>)}</div> : <p class="projects-empty">Event photo albums will appear here when their captions and event details are ready.</p>}
  </section>
</BaseLayout>
