---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isPublished } from '../../lib/content';
import { formatDate } from '../../lib/dates';

interface Props { article: CollectionEntry<'news'> }

export async function getStaticPaths() {
  const articles = await getCollection('news', isPublished);
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const { title, category, summary, publishedAt, image, officialUrl, attachment } = article.data;
---

<BaseLayout title={title} description={summary} noindex={false}>
  <nav class="project-breadcrumbs" aria-label="Breadcrumb"><a href="/news/">News</a><span aria-hidden="true">/</span><span aria-current="page">{title}</span></nav>
  <article class="editorial-detail">
    <header class="editorial-detail__header"><span class="badge badge--category">{category}</span><h1>{title}</h1><p>{summary}</p>{publishedAt && <time datetime={publishedAt}>{formatDate(publishedAt)}</time>}</header>
    {image && <figure class="editorial-detail__hero"><img src={image.src} alt={image.alt} width={image.width ?? 1200} height={image.height ?? 675} decoding="async" />{image.caption && <figcaption>{image.caption}</figcaption>}</figure>}
    <div class="editorial-detail__prose"><Content /></div>
    {(officialUrl || attachment) && <div class="editorial-detail__resources"><h2>Sources & resources</h2>{officialUrl && <a href={officialUrl} target="_blank" rel="noopener noreferrer">Official source <span aria-hidden="true">↗</span></a>}{attachment && <a href={attachment} download>Download attachment</a>}</div>}
  </article>
</BaseLayout>
