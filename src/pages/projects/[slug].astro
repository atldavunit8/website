---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { isPublished } from '../../lib/content';

type Project = CollectionEntry<'projects'>;
type Award = CollectionEntry<'awards'>;

interface Props {
  project: Project;
  relatedProjects: Project[];
  projectAwards: Award[];
}

export async function getStaticPaths() {
  const [projects, awards] = await Promise.all([
    getCollection('projects', isPublished),
    getCollection('awards', isPublished),
  ]);

  return projects.map((project) => ({
    params: { slug: project.id },
    props: {
      project,
      relatedProjects: projects
        .filter((other) => other.id !== project.id)
        .sort((a, b) =>
          Number(b.data.category === project.data.category) - Number(a.data.category === project.data.category) ||
          (b.data.year ?? 0) - (a.data.year ?? 0) ||
          a.data.title.localeCompare(b.data.title),
        )
        .slice(0, 3),
      projectAwards: awards
        .filter((award) => award.data.projectId === project.id)
        .sort((a, b) => (b.data.date ?? String(b.data.year ?? '')).localeCompare(a.data.date ?? String(a.data.year ?? ''))),
    },
  }));
}

const { project, relatedProjects, projectAwards } = Astro.props;
const { Content } = await render(project);
const { title, summary, category, status, year, cover, gallery, problem, objective, workingMechanism, team, mentor, technologies, materials, reportPdf, videoUrl } = project.data;
---

<BaseLayout title={title} description={summary} noindex={false}>
  <nav class="project-breadcrumbs" aria-label="Breadcrumb">
    <a href="/projects/">Projects</a><span aria-hidden="true">/</span><span aria-current="page">{title}</span>
  </nav>

  <article class="project-detail">
    <header class:list={['project-detail__header', { 'project-detail__header--with-cover': Boolean(cover) }]}>
      <div class="project-detail__heading">
        <p class="eyebrow">Student innovation</p>
        <h1>{title}</h1>
        <p class="project-detail__summary">{summary}</p>
        <div class="project-card__meta">
          <span class="badge badge--category">{category}</span>
          <span class="badge badge--status">{status ?? 'Status not specified'}</span>
          {year && <span class="project-detail__year">Project year: {year}</span>}
        </div>
      </div>
      {cover && (
        <figure class="project-detail__cover">
          <img src={cover.src} alt={cover.alt} width={cover.width ?? 1200} height={cover.height ?? 675} decoding="async" fetchpriority="high" />
          {cover.caption && <figcaption>{cover.caption}</figcaption>}
        </figure>
      )}
    </header>

    <div class="project-detail__content">
      <div class="project-detail__main">
        <section class="project-detail__section" aria-labelledby="project-problem">
          <h2 id="project-problem">The problem</h2>
          <p>{problem}</p>
        </section>

        {objective && (
          <section class="project-detail__section" aria-labelledby="project-objective">
            <h2 id="project-objective">Objective</h2>
            <p>{objective}</p>
          </section>
        )}

        <section class="project-detail__section" aria-labelledby="project-story">
          <h2 id="project-story">Project story</h2>
          <div class="project-detail__prose"><Content /></div>
        </section>

        {workingMechanism && (
          <section class="project-detail__section" aria-labelledby="project-mechanism">
            <h2 id="project-mechanism">How it works</h2>
            <p>{workingMechanism}</p>
          </section>
        )}

        {gallery.length > 0 && (
          <section class="project-detail__section" aria-labelledby="project-gallery">
            <h2 id="project-gallery">Project gallery</h2>
            <div class="project-detail__gallery">
              {gallery.map((image) => (
                <figure>
                  <img src={image.src} alt={image.alt} width={image.width ?? 800} height={image.height ?? 600} loading="lazy" decoding="async" />
                  {image.caption && <figcaption>{image.caption}</figcaption>}
                </figure>
              ))}
            </div>
          </section>
        )}

        {projectAwards.length > 0 && (
          <section class="project-detail__section" aria-labelledby="project-achievements">
            <h2 id="project-achievements">Selected achievements</h2>
            <ul class="project-detail__achievements">
              {projectAwards.map((award) => (
                <li>
                  <span class="badge badge--category">{award.data.achievementType}</span>
                  <strong>{award.data.result}</strong>
                  <span>{award.data.competition ?? award.data.organiser}</span>
                  {(award.data.date || award.data.academicYear || award.data.year) && <small>{award.data.date ?? award.data.academicYear ?? award.data.year}</small>}
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>

      {(team.length > 0 || mentor || technologies.length > 0 || materials.length > 0 || reportPdf || videoUrl) && (
        <aside class="project-detail__facts" aria-label="Project details and resources">
          {team.length > 0 && <div><h2>Student team</h2><ul>{team.map((member) => <li>{member}</li>)}</ul></div>}
          {mentor && <div><h2>Mentor</h2><p>{mentor}</p></div>}
          {technologies.length > 0 && <div><h2>Technologies</h2><ul>{technologies.map((technology) => <li>{technology}</li>)}</ul></div>}
          {materials.length > 0 && <div><h2>Materials</h2><ul>{materials.map((material) => <li>{material}</li>)}</ul></div>}
          {(reportPdf || videoUrl) && (
            <div>
              <h2>Project resources</h2>
              {reportPdf && <a href={reportPdf} type="application/pdf" download>Download {title} report (PDF)</a>}
              {videoUrl && <a href={videoUrl} target="_blank" rel="noopener noreferrer">Watch project video <span aria-hidden="true">↗</span></a>}
            </div>
          )}
        </aside>
      )}
    </div>
  </article>

  {relatedProjects.length > 0 && (
    <section class="project-detail__related" aria-labelledby="related-projects-heading">
      <div class="section-topline">
        <div class="section-heading"><p class="eyebrow">Keep exploring</p><h2 id="related-projects-heading">Related projects</h2></div>
        <a class="text-link" href="/projects/">All projects <span aria-hidden="true">→</span></a>
      </div>
      <div class="card-grid">
        {relatedProjects.map((related) => (
          <ProjectCard
            title={related.data.title}
            summary={related.data.summary}
            category={related.data.category}
            status={related.data.status}
            year={related.data.year}
            image={related.data.cover}
            href={`/projects/${related.id}/`}
          />
        ))}
      </div>
    </section>
  )}
</BaseLayout>
