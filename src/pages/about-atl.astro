---
import BaseLayout from '../layouts/BaseLayout.astro';
---

// EDIT HERE: each string is one paragraph on the page (basic HTML like <strong> is allowed).
const intro = 'The Atal Tinkering Lab (ATL) at DAV Public School, Unit-VIII, Bhubaneswar is a dedicated innovation space designed to encourage curiosity, creativity, problem-solving and hands-on learning among students in 2017.';
const paragraphs = [
  'Established under the Atal Innovation Mission, NITI Aayog, the lab provides students with opportunities to explore science, technology, engineering and design beyond the conventional classroom. It enables young innovators to experiment with electronics, robotics, coding, 3D design, prototyping, computational thinking and other emerging technologies.',
  'At the ATL, students are encouraged to identify real-world problems, develop ideas, build prototypes, test their solutions and learn through continuous experimentation. The emphasis is not only on technology, but also on teamwork, design thinking, communication and responsible innovation.',
  'Through workshops, projects, competitions, mentoring and collaborative activities, the lab aims to develop a strong culture of innovation within the school and empower students to become confident creators and problem-solvers.',
  'Our ATL represents a space where students are free to <strong>think, make, experiment and innovate</strong>—turning curiosity into ideas and ideas into meaningful solutions.',
];
// Optional: put a photo at public/images/about/atl-lab.jpg and set to true.
const showImage = false;

<BaseLayout title="About ATL"><RoutePlaceholder title="About ATL" purpose="The final ATL introduction will be added later." /></BaseLayout>

<BaseLayout title="About ATL" description="About the Atal Tinkering Lab at DAV Public School, Unit-VIII, Bhubaneswar.">
  <header class="projects-intro"><p class="eyebrow">About our ATL</p><h1>About the Atal Tinkering Lab</h1><p>{intro}</p></header>
  <section class="about-page">
    <div class="about-page__text">{paragraphs.map((text) => <p set:html={text} />)}</div>
    {showImage && <img class="about-page__image" src="/images/about/atl-lab.jpg" alt="Students working in the Atal Tinkering Lab" width="900" height="600" loading="lazy" />}
  </section>
</BaseLayout>