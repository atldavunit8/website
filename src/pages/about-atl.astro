---
import BaseLayout from '../layouts/BaseLayout.astro';
---

// EDIT HERE: each string is one paragraph on the page.
const intro = 'At DAV Public School, Unit-VIII, Bhubaneswar, the Atal Tinkering Lab supports curiosity and innovation. The lab began in 2017.';
const paragraphs = [
  'Paragraph 1: what the ATL is and what students do here.',
  'Paragraph 2: the tools and areas (electronics, robotics, coding, design thinking...).',
  'Paragraph 3: how students take part (clubs, sessions, competitions).',
];
// Optional: put a photo at public/images/about/atl-lab.jpg and set to true.
const showImage = false;

<BaseLayout title="About ATL"><RoutePlaceholder title="About ATL" purpose="The final ATL introduction will be added later." /></BaseLayout>

<BaseLayout title="About ATL" description="About the Atal Tinkering Lab at DAV Public School, Unit-VIII, Bhubaneswar.">
  <header class="projects-intro"><p class="eyebrow">About our ATL</p><h1>About the Atal Tinkering Lab</h1><p>{intro}</p></header>
  <section class="about-page">
    <div class="about-page__text">{paragraphs.map((text) => <p>{text}</p>)}</div>
    {showImage && <img class="about-page__image" src="/images/about/atl-lab.jpg" alt="Students working in the Atal Tinkering Lab" width="900" height="600" loading="lazy" />}
  </section>
</BaseLayout>