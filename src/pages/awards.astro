---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AwardCard from '../components/AwardCard.astro';
import { isPublished } from '../lib/content';

type Award = CollectionEntry<'awards'>;
const awardYearKey = (award: Award) => award.data.academicYear ?? String(award.data.year ?? award.data.date?.slice(0, 4) ?? 'Year not supplied');
const [publishedAwards, projects] = await Promise.all([
  getCollection('awards', isPublished),
  getCollection('projects', isPublished),
]);
const yearRank = (key: string) => Number.parseInt(key, 10) || 0;
const awards = [...publishedAwards].sort((a, b) =>
  yearRank(awardYearKey(b)) - yearRank(awardYearKey(a)) ||
  a.data.title.localeCompare(b.data.title),
);
const yearKeys = [...new Set(awards.map(awardYearKey))].sort((a, b) =>
  yearRank(b) - yearRank(a),
);
const levels = ['School', 'District', 'Regional', 'State', 'National', 'International', 'Level not specified'];
const types = ['Award', 'Selection', 'Participation', 'Grant', 'Recognition'];
const projectById = new Map(projects.map((project) => [project.id, project]));
const OTHER = 'Other competitions';
const levelDisplay = ['International', 'National', 'State', 'Regional', 'District', 'School', 'Level not specified'];
const levelRank = (level?: string) => (level ? levels.indexOf(level) : -1);
const programmeName = (award: Award) => award.data.programme ?? OTHER;
const slugify = (value: string) => value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const programmes = [...new Set(awards.map(programmeName))]
  .map((name) => {
    const items = awards.filter((award) => programmeName(award) === name);
    const years = items.map((award) => yearRank(awardYearKey(award))).filter(Boolean);
    return {
      name,
      items,
      topLevel: levelDisplay.find((level) => items.some((award) => (award.data.level ?? 'Level not specified') === level)) ?? 'Level not specified',
      rank: Math.max(...items.map((award) => levelRank(award.data.level))),
      projectCount: new Set(items.map((award) => award.data.projectId).filter(Boolean)).size,
      yearText: years.length ? (Math.min(...years) === Math.max(...years) ? String(years[0]) : `${Math.min(...years)}–${Math.max(...years)}`) : '',
      levelGroups: levelDisplay
        .map((level) => ({ level, items: items.filter((award) => (award.data.level ?? 'Level not specified') === level) }))
        .filter((group) => group.items.length > 0),
    };
  })
  .sort((a, b) => Number(a.name === OTHER) - Number(b.name === OTHER) || b.rank - a.rank || b.items.length - a.items.length || a.name.localeCompare(b.name));
const featured = awards.filter((award) => award.data.featured && award.data.achievementType === 'Award');
---

<BaseLayout title="Achievements and Awards" description="Browse published awards and achievements from the Atal Tinkering Lab at DAV Public School, Unit-VIII." noindex={false}>
  <header class="projects-intro">
    <p class="eyebrow">Student achievements</p>
    <h1>Achievements & Awards</h1>
    <p>Explore ATL results by competition, level and achievement type. An award win, selection, grant or recognition keeps its own label.</p>
  </header>

  <section class="awards-archive" aria-labelledby="awards-archive-heading">
    <div class="projects-section__heading">
      <h2 id="awards-archive-heading">Published records</h2>
      <p id="award-result-count" aria-live="polite">{awards.length} {awards.length === 1 ? 'record' : 'records'} shown</p>
    </div>

    {awards.length > 0 ? (
      <>
        <div class="award-filters" data-award-filters hidden>
          <div><label for="award-year-filter">Year</label><select id="award-year-filter"><option value="all">All years</option>{yearKeys.map((key) => <option value={key}>{key}</option>)}</select></div>
          <div><label for="award-level-filter">Level</label><select id="award-level-filter"><option value="all">All levels</option>{levels.map((value) => <option value={value}>{value}</option>)}</select></div>
          <div><label for="award-type-filter">Achievement</label><select id="award-type-filter"><option value="all">All types</option>{types.map((value) => <option value={value}>{value}</option>)}</select></div>
          <button type="button" class="award-filters__reset" data-award-reset>Clear filters</button>
        </div>

        <div class="award-groups">
          {programmes.map((programme) => (
            <details class="programme" data-award-group>
              <summary class="programme__summary">
                <span class="programme__name">{programme.name}</span>
                <span class="programme__meta">
                  <span class="badge badge--category">Highest: {programme.topLevel}</span>
                  <span>{programme.items.length} {programme.items.length === 1 ? 'record' : 'records'}</span>
                  {programme.projectCount > 0 && <span>{programme.projectCount} {programme.projectCount === 1 ? 'project' : 'projects'}</span>}
                  {programme.yearText && <span>{programme.yearText}</span>}
                </span>
                <span class="programme__chevron" aria-hidden="true">⌄</span>
              </summary>
              <div class="programme__body">
                {programme.levelGroups.map((group) => (
                  <section class="programme__level" data-award-group aria-labelledby={`level-${slugify(programme.name)}-${slugify(group.level)}`}>
                    <h3 id={`level-${slugify(programme.name)}-${slugify(group.level)}`}>{group.level}</h3>
                    <div class="award-grid">
                      {group.items.map((award) => (
                        <div class="award-grid__item" data-award-year={awardYearKey(award)} data-award-level={award.data.level ?? 'Level not specified'} data-award-type={award.data.achievementType}>
                          <AwardCard award={award} project={projectById.get(award.data.projectId ?? '')} />
                        </div>
                      ))}
                    </div>
                  </section>
                ))}
              </div>
            </details>
          ))}
        </div>
        <p class="projects-empty" data-award-empty hidden>No records match these filters. Clear filters to see the full archive.</p>
      </>
    ) : (
      <p class="projects-empty">Achievement records are being prepared.</p>
    )}
  </section>

  {featured.length > 0 && (
    <section class="awards-wall" aria-labelledby="awards-wall-heading">
      <div class="section-topline">
        <div class="section-heading"><p class="eyebrow">Wall of Fame</p><h2 id="awards-wall-heading">Featured wins</h2></div>
        <a class="text-link" href="/projects/featured/">Explore featured projects <span aria-hidden="true">→</span></a>
      </div>
      <div class="award-wall-grid">
        {featured.map((award) => (
          <article class="award-wall-card">
            <span class="badge badge--category">{award.data.level ?? 'Award'}</span>
            <h3>{award.data.result}</h3>
            <p>{award.data.competition ?? award.data.organiser}</p>
            {(award.data.academicYear || award.data.year || award.data.date) && <p class="award-wall-card__year">{award.data.academicYear ?? award.data.year ?? award.data.date}</p>}
            {projectById.get(award.data.projectId ?? '') && <a class="text-link" href={`/projects/${award.data.projectId}/`}>{projectById.get(award.data.projectId ?? '')?.data.title} <span aria-hidden="true">→</span></a>}
          </article>
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<script>
  const filters = document.querySelector<HTMLElement>('[data-award-filters]');
  const yearSelect = document.querySelector<HTMLSelectElement>('#award-year-filter');
  const levelSelect = document.querySelector<HTMLSelectElement>('#award-level-filter');
  const typeSelect = document.querySelector<HTMLSelectElement>('#award-type-filter');
  const resetButton = document.querySelector<HTMLButtonElement>('[data-award-reset]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-award-year]')];
  const groups = [...document.querySelectorAll<HTMLElement>('[data-award-group]')];
  const programmes = [...document.querySelectorAll<HTMLDetailsElement>('details.programme')];  
  const count = document.querySelector<HTMLElement>('#award-result-count');
  const empty = document.querySelector<HTMLElement>('[data-award-empty]');

  if (filters && yearSelect && levelSelect && typeSelect && resetButton && cards.length && count && empty) {
    filters.hidden = false;
    const applyFilters = () => {
      let visible = 0;
      for (const card of cards) {
        card.hidden = (yearSelect.value !== 'all' && card.dataset.awardYear !== yearSelect.value) ||
          (levelSelect.value !== 'all' && card.dataset.awardLevel !== levelSelect.value) ||
          (typeSelect.value !== 'all' && card.dataset.awardType !== typeSelect.value);
        if (!card.hidden) visible += 1;
      }
      for (const group of groups) group.hidden = !group.querySelector('[data-award-year]:not([hidden])');
      const filtering = yearSelect.value !== 'all' || levelSelect.value !== 'all' || typeSelect.value !== 'all';
      if (filtering) for (const programme of programmes) if (!programme.hidden) programme.open = true;      
      count.textContent = `${visible} ${visible === 1 ? 'record' : 'records'} shown`;
      empty.hidden = visible !== 0;
    };
    for (const select of [yearSelect, levelSelect, typeSelect]) select.addEventListener('change', applyFilters);
    resetButton.addEventListener('click', () => {
      yearSelect.value = levelSelect.value = typeSelect.value = 'all';
      applyFilters();
      yearSelect.focus();
    });
  }
</script>
