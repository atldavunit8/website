---
interface Image {
  src: string;
  alt: string;
  width?: number;
  height?: number;
}

interface Props {
  title: string;
  summary: string;
  href: string;
  eyebrow: string;
  meta?: string;
  image?: Image;
  status?: string;
}

const { title, summary, href, eyebrow, meta, image, status } = Astro.props;
---

<article class="editorial-card">
  {image && <a class="editorial-card__image" href={href} aria-label={`View ${title}`}><img src={image.src} alt={image.alt} width={image.width ?? 800} height={image.height ?? 600} loading="lazy" decoding="async" /></a>}
  <div class="editorial-card__body">
    <div class="editorial-card__tags"><span class="badge badge--category">{eyebrow}</span>{status && <span class="badge badge--status">{status}</span>}</div>
    <h3><a href={href}>{title}</a></h3>
    {meta && <p class="editorial-card__meta">{meta}</p>}
    <p>{summary}</p>
    <a class="text-link" href={href}>Read more <span aria-hidden="true">→</span></a>
  </div>
</article>
