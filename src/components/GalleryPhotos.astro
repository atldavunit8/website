---
import fs from 'node:fs';
import path from 'node:path';

const root = path.join(process.cwd(), 'public', 'gallery');
const imageExt = /\.(jpe?g|png|webp|avif|gif)$/i;
const byName = new Intl.Collator(undefined, { numeric: true }).compare;

// Reads every image in public/gallery, including any subfolders
function collect(dir: string, urlBase: string): { src: string; alt: string }[] {
  return fs
    .readdirSync(dir, { withFileTypes: true })
    .sort((a, b) => byName(a.name, b.name))
    .flatMap((entry) => {
      const url = `${urlBase}/${encodeURIComponent(entry.name)}`;
      if (entry.isDirectory()) return collect(path.join(dir, entry.name), url);
      if (!imageExt.test(entry.name)) return [];
      return [{ src: url, alt: `ATL gallery photo: ${entry.name.replace(/\.[^.]+$/, '').replace(/[-_]+/g, ' ')}` }];
    });
}

const photos = fs.existsSync(root) ? collect(root, '/gallery') : [];
---

<section class="photos" aria-labelledby="photo-gallery">
  <div class="photos__head">
    <h2 id="photo-gallery">Photo gallery</h2>
    <strong>{photos.length} {photos.length === 1 ? 'photo' : 'photos'}</strong>
  </div>

  {photos.length === 0 ? (
    <p class="photos__empty">Photos will appear here soon.</p>
  ) : (
    <div class="photos__grid">
      {photos.map((photo) => (
        <a class="photos__item" href={photo.src} target="_blank" rel="noopener">
          <img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" />
        </a>
      ))}
    </div>
  )}
</section>

<style>
  .photos { display: grid; gap: var(--space-5); }
  .photos__head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-3); }
  .photos__head h2 { margin: 0; }
  .photos__empty { border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--surface); padding: var(--space-5); margin: 0; }
  .photos__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr)); gap: var(--space-4); }
  .photos__item { display: block; overflow: hidden; border: 1px solid var(--line); border-radius: var(--radius-md); background: var(--surface); box-shadow: var(--shadow-soft); }
  .photos__item img { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; transition: transform 0.25s ease; }
  .photos__item:hover img { transform: scale(1.04); }
  .photos__item:focus-visible { outline: 3px solid var(--blue); outline-offset: 3px; }
</style>